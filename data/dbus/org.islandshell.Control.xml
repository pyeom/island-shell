<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
  "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Bus name: org.islandshell.Shell
  Object:   /org/islandshell/Shell
-->
<node>
  <interface name="org.islandshell.Control">
    <!-- Open or close the launcher on the focused monitor. -->
    <method name="ToggleLauncher"/>
    <!-- Expand the island on the focused monitor. An empty name opens what a
         click on the pill opens: the dashboard, or the activity in the pill
         if it is not background information (music, privacy). Fails with
         org.islandshell.Error.UnknownActivity. -->
    <method name="Expand">
      <arg name="activity" type="s" direction="in"/>
    </method>
    <method name="Collapse"/>
    <!-- Re-read config.toml, the theme and user activities. -->
    <method name="Reload"/>
    <method name="SetDnd">
      <arg name="enabled" type="b" direction="in"/>
    </method>
    <!-- Open the power menu on the focused monitor. -->
    <method name="ShowPower"/>
    <!-- Open quick settings (network, bluetooth, volume, ...) on the focused monitor. -->
    <method name="ShowQuickSettings"/>
    <!-- Take a screenshot: region | window | output | active. -->
    <method name="Screenshot">
      <arg name="mode" type="s" direction="in"/>
    </method>
    <!-- Wallpapers: "pick" opens the picker, "random" applies a random one. -->
    <method name="Wallpaper">
      <arg name="action" type="s" direction="in"/>
    </method>
    <!-- Open the settings window. -->
    <method name="ShowSettings"/>
    <!-- Open the settings window on a page: "calendar". -->
    <method name="ShowSettingsPage">
      <arg name="page" type="s" direction="in"/>
    </method>
    <!-- The player the island shows: play-pause | next | previous. Fails
         with org.islandshell.Error.NoPlayer when nothing is playing. -->
    <method name="Media">
      <arg name="action" type="s" direction="in"/>
    </method>
    <!-- Default output: up | down (5%), +N | -N (points), N (percent),
         mute (toggle); mic-mute toggles the default input. Shows the OSD. -->
    <method name="Volume">
      <arg name="action" type="s" direction="in"/>
    </method>
    <!-- Names of all registered activities. -->
    <method name="ListActivities">
      <arg name="names" type="as" direction="out"/>
    </method>
    <property name="Dnd" type="b" access="read"/>
    <property name="Version" type="s" access="read"/>
  </interface>
</node>

# Optional, for sessions that run graphical-session.target (e.g. uwsm):
#   systemctl --user enable --now island-shell.service
# Without it, start island-shell-run from the compositor's autostart.
[Unit]
Description=island-shell, a Dynamic Island style shell for Hyprland
Documentation=file:///usr/share/doc/island-shell/README.md
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
ExecStart=/usr/bin/island-shell
Restart=on-failure
RestartSec=1
# Exit status 3: another instance already owns the D-Bus name.
RestartPreventExitStatus=3
Slice=app-graphical.slice

[Install]
WantedBy=graphical-session.target
